<%- include("./partials/header") %>

<div class="container">
    <form>
        <fieldset>
            <legend>Editar</legend>
            <label>Nome</label>
            <input type="hidden" name="id" value="<%= disc.id %>">
            <input type="text" name="name" placeholder="Nome do disco" value="<%=disc.name%>" maxlength="50">
            <label>Imagem</label>
            <button type="button" class="button button-accent">Selecionar imagem</button>
            <input type="file" name="image" class="file" accept=".png,.jpg,.jpeg">       
            <img id="preview" src="/uploads/<%=disc.image%>">
            <label>Descrição</label>
            <textarea name="description" rows="3" placeholder="Descrição do disco" maxlength="255"><%=disc.description%></textarea>
            <button type="submit" class="button button-accent">Atualizar Disco</button>
            <div class="message"></div>
        </fieldset>
    </form>
    <script src="/js/edit.js"></script>
</div>

</body>

</html>